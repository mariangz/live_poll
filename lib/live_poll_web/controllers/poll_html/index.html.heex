<h1>Available Polls</h1>

<%= if Enum.empty?(@polls) do %>
  <p>No polls available.</p>
<% else %>
  <ul class="list-disc pl-6">
    <%= for poll <- @polls do %>
      <li>
        <.link href={~p"/polls/#{poll.id}"}>
          {poll.question}
        </.link>
      </li>
    <% end %>
  </ul>
<% end %>
